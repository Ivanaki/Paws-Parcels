title: Start
---
/// Whether Capsley like you or not. This starts true, but may change.
<<declare $capsley_likes_you = true as bool>>
/// The player's name. The player chooses this. It starts empty.
<<declare $player_name = "" as string>>

<<set_emotion "smile">>
Capsley: Hello, I am Mr Capsley. #line:0d5449e 
<<set_emotion "idle">>
Capsley: Who are you then? #line:01a2cdf 

-> I'm Capsule, but my friends call me "Tic Tac". No idea why... #line:087d94c 
    <<set $player_name to "Tic Tac">>
-> The name's Triquandle. #line:08ba09e 
    <<set $player_name to "Triquandle">>
-> Pyramid. Why - who wants to know? #line:05f4d3e 
    <<set $player_name to "Pyramid">>
    <<set $capsley_likes_you to false>>

<<if $capsley_likes_you>>
    <<set_emotion "smile">>
    Capsley: Nice to meet you {$player_name}! #line:086a8aa 
<<else>>
    <<set_emotion "sad">>
    Capsley: No need to be so rude... #line:0e18a0e 
    <<set_emotion "sad">>
    Capsley: Maybe you should be called Grumpy {$player_name}. #line:001950a 
<<endif>>
===
