      \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u0438 \u0441\u043F\u0440\u043E\u0441\u0438,
      \u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u043B\u0438 \u043E\u043D\u0430
      \u043F\u0440\u043E\u0442\u0438\u0432 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F
