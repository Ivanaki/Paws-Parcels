  m_TableData:
  - m_Id: 12822695597678592
    m_Localized: "\u042D\u0442\u043E \u043F\u0440\u0438\u043C\u0435\u0440. \u041F\u0440\u0438\u0432\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 12832438861012998
    m_Localized: 'Capsley: Maybe you should be called Grumpy {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 12832438861012997
    m_Localized: 'Capsley: No need to be so rude...'
    m_Metadata:
      m_Items: []
  - m_Id: 12832438861012996
    m_Localized: 'Capsley: Nice to meet you {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 12832438861012995
    m_Localized: Pyramid. Why - who wants to know?
    m_Metadata:
      m_Items: []
  - m_Id: 12832438861012994
    m_Localized: The name's Triquandle.
    m_Metadata:
      m_Items: []
  - m_Id: 12832438861012993
    m_Localized: I'm Capsule, but my friends call me "Tic Tac". No idea why...
    m_Metadata:
      m_Items: []
  - m_Id: 12832438861012992
    m_Localized: 'Capsley: Who are you then?'
    m_Metadata:
      m_Items: []
  - m_Id: 12832438827458560
    m_Localized: 'Capsley: Hello, I am Mr Capsley.'
    m_Metadata:
      m_Items: []
  - m_Id: 15954733523640320
    m_Localized: This is an example of a Yarn Spinner script. Write your dialogue
      here!
    m_Metadata:
      m_Items: []
  - m_Id: 15954881121198080
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442. \u042F \u0422\u0435\u0434."
    m_Metadata:
      m_Items: []
