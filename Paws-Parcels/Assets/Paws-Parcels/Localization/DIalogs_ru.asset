  - m_Id: 22122642331918340
    m_Localized: "\u0417\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A: \u0415\u0441\u043B\u0438
      \u0432\u0434\u0440\u0443\u0433 \u0431\u0443\u0434\u0435\u0442\u0435 \u043F\u0440\u043E\u0435\u0437\u0434\u043E\u043C,
      \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u0435, \u043A\u0430\u043A \u0434\u0435\u043B\u0430
      \u0443 \u0411\u0443\u043B\u043E\u0447\u043D\u0438\u0446\u044B. \u0412\u0441\u0435
      \u043B\u0438 \u0443 \u043D\u0435\u0435 \u0445\u043E\u0440\u043E\u0448\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 22122642331918341
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041E\u043D\u0430 \u0432\u0430\u0448\u0430
      \u043F\u043E\u0434\u0440\u0443\u0433\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 22122642331918342
    m_Localized: "\u0417\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A: \u041C\u044B
      \u0435\u0434\u0432\u0430 \u0437\u043D\u0430\u043A\u043E\u043C\u044B, \u0435\u0441\u043B\u0438
      \u0447\u0435\u0441\u0442\u043D\u043E\u2026\u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E
      \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22122642331918343
    m_Localized: "\u0418\u0433\u0440\u043E\u043A:  \u041C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u0435\u0439 \u043F\u0440\u0438\u0432\u0435\u0437\u0442\u0438
      \u0447\u0442\u043E \u043D\u0438\u0431\u0443\u0434\u044C \u043E\u0442 \u0442\u0435\u0431\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 22122642331918344
    m_Localized: "\u0417\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A: \u0422\u043E\u0447\u043D\u043E,
      \u0434\u0430\u0432\u0430\u0439 \u0442\u0430\u043A \u0438 \u0441\u0434\u0435\u043B\u0430\u0435\u043C,
      \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E\u0431\u044B \u0442\u0430\u043A\u043E\u0433\u043E
      \u043F\u043E\u0434\u0430\u0440\u0438\u0442\u044C\u2026\u044D\u0445\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22122642331918345
    m_Localized: "\u0417\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A: \u0415\u0437\u0436\u0430\u0439
      \u0441\u043A\u043E\u0440\u0435\u0435, \u0436\u0434\u0443 \u043D\u0435 \u0434\u043E\u0436\u0434\u0443\u0441\u044C
      \u0432\u0435\u0441\u0442\u0435\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614784
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u0410, \u044D\u0442\u043E
      \u0441\u043D\u043E\u0432\u0430 \u0412\u044B. \u0427\u0435\u043C \u043E\u0431\u044F\u0437\u0430\u043D?"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614785
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u042F \u0445\u043E\u0442\u0435\u043B
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E \u041A\u043E\u0442\u0438\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614786
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u041E \u0432\u0430\u0448\u0435\u043C
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u043C \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614787
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0414\u0430. \u042F \u0432\u0441\u0435
      \u0435\u0449\u0435 \u0445\u043E\u0447\u0443 \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u0435\u0433\u043E \u0432 \u0448\u043A\u043E\u043B\u0443, \u043D\u043E \u043D\u0443\u0436\u043D\u0443\u044E
      \u0441\u0443\u043C\u043C\u0443 \u0442\u0430\u043A \u0438 \u043D\u0435 \u0441\u043E\u0431\u0440\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614788
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u041F\u043E\u043D\u0438\u043C\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614789
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041D\u043E \u043C\u043D\u0435
      \u0441\u043A\u0430\u0437\u0430\u043B\u0438, \u0447\u0442\u043E, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u0438\u043D\u043E\u0433\u0434\u0430 \u0412\u044B \u0432\u0441\u0435 \u0436\u0435
      \u0434\u0435\u043B\u0430\u0435\u0442\u0435 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614790
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u0425\u043C.
      \u041B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u043E, \u043A\u0442\u043E
      \u0436\u0435 \u044D\u0442\u043E \u0412\u0430\u043C \u0441\u043A\u0430\u0437\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614791
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041D\u0435 \u0442\u0430\u043A
      \u0432\u0430\u0436\u043D\u043E. \u0412\u0430\u0436\u043D\u043E \u0442\u043E,
      \u0447\u0442\u043E \u041A\u043E\u0442\u0438\u043A\u0443 \u043D\u0443\u0436\u0435\u043D
      \u0434\u043E\u043C, \u0430 \u0424\u0435\u0440\u043C\u0435\u0440\u0435\u043D\u043A\u0443
      \u043D\u0443\u0436\u0435\u043D \u0434\u0440\u0443\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614792
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u0412\u043E\u0442
      \u0434\u0430\u0436\u0435 \u043A\u0430\u043A..."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614793
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0412\u0430\u0448 \u0441\u044B\u043D
      \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0435\u0442 \u0443\u0447\u0438\u0442\u044C\u0441\u044F
      \u043D\u0435 \u043E\u0434\u0438\u043D. \u041E\u043D \u0441\u0430\u043C \u0445\u043E\u0442\u0435\u043B
      \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0412\u0430\u0441 \u0432\u0437\u044F\u0442\u044C
      \u041A\u043E\u0442\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614794
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u0421\u0430\u043C
      \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614795
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u0410, \u044D\u0442\u043E
      \u0441\u043D\u043E\u0432\u0430 \u0412\u044B. \u0427\u0435\u043C \u043E\u0431\u044F\u0437\u0430\u043D?"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614796
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u042F \u0445\u043E\u0442\u0435\u043B
      \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E \u041A\u043E\u0442\u0438\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614797
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u041E \u0432\u0430\u0448\u0435\u043C
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u043C \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614798
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0414\u0430. \u042F \u0432\u0441\u0435
      \u0435\u0449\u0435 \u0445\u043E\u0447\u0443 \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u0435\u0433\u043E \u0432 \u0448\u043A\u043E\u043B\u0443, \u043D\u043E \u043D\u0443\u0436\u043D\u0443\u044E
      \u0441\u0443\u043C\u043C\u0443 \u0442\u0430\u043A \u0438 \u043D\u0435 \u0441\u043E\u0431\u0440\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614799
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u041F\u043E\u043D\u0438\u043C\u0430\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614800
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041D\u043E \u043C\u043D\u0435
      \u0441\u043A\u0430\u0437\u0430\u043B\u0438, \u0447\u0442\u043E, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u0438\u043D\u043E\u0433\u0434\u0430 \u0412\u044B \u0432\u0441\u0435 \u0436\u0435
      \u0434\u0435\u043B\u0430\u0435\u0442\u0435 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614801
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u0425\u043C.
      \u041B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u043E, \u043A\u0442\u043E
      \u0436\u0435 \u044D\u0442\u043E \u0412\u0430\u043C \u0441\u043A\u0430\u0437\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614802
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041D\u0435 \u0442\u0430\u043A
      \u0432\u0430\u0436\u043D\u043E. \u0412\u0430\u0436\u043D\u043E \u0442\u043E,
      \u0447\u0442\u043E \u041A\u043E\u0442\u0438\u043A\u0443 \u043D\u0443\u0436\u0435\u043D
      \u0434\u043E\u043C, \u0430 \u0424\u0435\u0440\u043C\u0435\u0440\u0435\u043D\u043A\u0443
      \u043D\u0443\u0436\u0435\u043D \u0434\u0440\u0443\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614803
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u041A\u043E\u0442\u0438\u043A
      \u043C\u043E\u0436\u0435\u0442 \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F.
      \u0414\u043B\u044F \u043D\u0435\u0433\u043E \u0432 \u0448\u043A\u043E\u043B\u0435
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0430\u0439\u0434\u0435\u0442\u0441\u044F
      \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614804
    m_Localized: "\u0418\u0433\u0440\u043E\u043A:  \u0412\u043E\u0442 \u0412\u044B
      \u0433\u0434\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614805
    m_Localized: "\u0421\u043E\u0432\u0430: \u0412 \u0437\u0434\u043E\u0440\u043E\u0432\u043E\u043C
      \u0442\u0435\u043B\u0435 \u2013 \u0437\u0434\u043E\u0440\u043E\u0432\u044B\u0439
      \u0434\u0443\u0445! \u0412 \u043C\u043E\u0438\u0445 \u0433\u043E\u0434\u0430\u0445
      \u044D\u0442\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E. \u0410 \u0412\u044B, \u043C\u043E\u043B\u043E\u0434\u043E\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u0442\u043E\u0442 \u0441\u0430\u043C\u044B\u0439
      \u043D\u043E\u0432\u044B\u0439 \u0434\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A?
      \u041D\u0430\u0441\u043B\u044B\u0448\u0430\u043D\u0430. \u041E\u0447\u0435\u043D\u044C
      \u043F\u0440\u0438\u044F\u0442\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614806
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0418 \u043C\u043D\u0435. \u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440
      \u043F\u0440\u043E\u0441\u0438\u043B \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C
      \u043F\u043E\u0441\u044B\u043B\u043A\u0443. \u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435,
      \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614807
    m_Localized: "\u0421\u043E\u0432\u0430: \u0412\u043E\u0442 \u0441\u043F\u0430\u0441\u0438\u0431\u043E!
      \u041A\u0430\u043A \u0442\u0430\u043C \u0432\u043D\u0443\u0447\u0435\u043A
      \u043C\u043E\u0439? \u0420\u0430\u0431\u043E\u0442\u0430\u0435\u0442? \u0422\u0435\u043F\u043B\u043E
      \u043E\u0434\u0435\u0432\u0430\u0435\u0442\u0441\u044F? (\u0441\u043C\u0435\u0435\u0442\u0441\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614808
    m_Localized: "\u0421\u043E\u0432\u0430: \u0410 \u043F\u0440\u0430\u0432\u043D\u0443\u043A\u0438
      \u043A\u043E\u0433\u0434\u0430? \u042D\u0445, \u0432\u043E\u0442 \u043E\u0441\u0442\u0430\u0432\u0438\u0442
      \u0436\u0435 \u0431\u0430\u0431\u0443\u0448\u043A\u0443 \u0431\u0435\u0437
      \u043F\u0440\u0430\u0432\u043D\u0443\u043A\u043E\u0432! \u0421\u043B\u0443\u0447\u0430\u0435\u043C,
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0442\u0435, \u043E\u043D \u0442\u0430\u043C
      \u0441\u0435\u0431\u0435 \u043D\u0435\u0432\u0435\u0441\u0442\u043A\u0443 \u0435\u0449\u0435
      \u043D\u0435 \u043D\u0430\u0448\u0435\u043B? \u041C\u043E\u0436\u0435\u0442,
      \u0435\u043C\u0443 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043A\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614809
    m_Localized: "\u0418\u0433\u0440\u043E\u043A:"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614810
    m_Localized: "\u0421\u043E\u0432\u0430: \u0415\u0437\u0436\u0430\u0439, \u0435\u0437\u0436\u0430\u0439
      \u0432\u043D\u0443\u0447\u0435\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614811
    m_Localized: "\u0421\u043E\u0432\u0430: \u041F\u0440\u0438\u0432 \u0447\u0434
      \u043A\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614812
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041A\u0440\u0438\u043D\u0436\u0430\u043D\u0443\u043B
      \u043D\u0435 \u043F\u043E \u0434\u0435\u0442\u0441\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614813
    m_Localized: "\u0421\u043E\u0432\u0430: \u0428\u043B\u0435\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614814
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614815
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0423 \u043C\u0435\u043D\u044F
      \u0437\u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F \u0431\u0435\u043D\u0437\u0438\u043D,
      \u043D\u0430\u0434\u043E \u0431\u044B \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0441 \u0437\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A\u043E\u043C..."
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614816
    m_Localized: "\u0411\u0443\u043B\u043E\u0447\u043D\u0438\u0446\u0430: \u041F\u0440\u0438\u0432
      \u0447\u0434 \u043A\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614817
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041A\u0440\u0438\u043D\u0436\u0430\u043D\u0443\u043B
      \u043D\u0435 \u043F\u043E \u0434\u0435\u0442\u0441\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614818
    m_Localized: "\u0411\u0443\u043B\u043E\u0447\u043D\u0438\u0446\u0430: \u0428\u043B\u0435\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614819
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614820
    m_Localized: "\u0411\u0443\u043B\u043E\u0447\u043D\u0438\u0446\u0430: \u042D\u0442\u043E
      \u043C\u043E\u0439 2 \u0434\u0438\u0430\u043B\u043E\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614821
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041A\u0440\u0438\u043D\u0436\u0430\u043D\u0443\u043B
      \u043D\u0435 \u043F\u043E \u0434\u0435\u0442\u0441\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614822
    m_Localized: "\u0411\u0443\u043B\u043E\u0447\u043D\u0438\u0446\u0430: \u042D\u0442\u043E
      \u043C\u043E\u0439 2 \u0434\u0438\u0430\u043B\u043E\u0433 \u043F\u043E\u0441\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614823
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614824
    m_Localized: "\u0411\u0443\u043B\u043E\u0447\u043D\u0438\u0446\u0430: \u042D\u0442\u043E
      \u043C\u043E\u0439 2 \u0434\u0438\u0430\u043B\u043E\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614825
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041A\u0440\u0438\u043D\u0436\u0430\u043D\u0443\u043B
      \u043D\u0435 \u043F\u043E \u0434\u0435\u0442\u0441\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614826
    m_Localized: "\u0411\u0443\u043B\u043E\u0447\u043D\u0438\u0446\u0430: \u042D\u0442\u043E
      \u043C\u043E\u0439 2 \u0434\u0438\u0430\u043B\u043E\u0433 \u043F\u043E\u0441\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 22123512490614827
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222006804480
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0421\u043A\u0430\u0437\u0430\u043B
      \u0432\u0441\u0435 \u043A\u0430\u043A \u0435\u0441\u0442\u044C. \u041E\u043D\u0430
      \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B\u0430
      \u0437\u0430 \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0430\u0441\u044C
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F \u0441 \u0442\u043E\u0431\u043E\u0439
      \u0443 \u041E\u0437\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496256
    m_Localized: "\u0417\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A: \u041F\u0440\u0430\u0432\u0434\u0430!?
      \u0412\u043E\u0442 \u044D\u0442\u043E \u0434\u0430... \u041D\u0435\u0443\u0436\u0435\u043B\u0438
      \u0438 \u043F\u0440\u0430\u0432\u0434\u0430 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0430\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496257
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0414\u0430. \u041F\u043E\u0445\u043E\u0436\u0435,
      \u043A\u0430\u0440\u0442\u0438\u043D\u0430 \u0435\u0439 \u043E\u0447\u0435\u043D\u044C
      \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496258
    m_Localized: "\u0417\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A: \u041D\u0443
      \u0432\u0441\u0435... \u0442\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u0437\u0430\u0434
      \u0434\u043E\u0440\u043E\u0433\u0438 \u043D\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496259
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041F\u043E\u0445\u043E\u0436\u0435
      \u043D\u0430 \u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496260
    m_Localized: "\u0417\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A: \u0417\u043D\u0430\u0435\u0448\u044C...
      \u043C\u044B \u0443\u0436\u0435 \u0443\u0441\u043F\u0435\u043B\u0438 \u0443\u0432\u0438\u0434\u0435\u0442\u044C\u0441\u044F.
      \u0418, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0432\u0441\u0435 \u043F\u0440\u043E\u0448\u043B\u043E
      \u0434\u0430\u0436\u0435 \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C
      \u044F \u043C\u0435\u0447\u0442\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496261
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0412\u043E\u0442 \u043A\u0430\u043A?
      \u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496262
    m_Localized: "\u0417\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A: \u0421\u043F\u0430\u0441\u0438\u0431\u043E.
      \u041A\u0442\u043E \u0431\u044B \u043C\u043E\u0433 \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C...
      \u0421\u0442\u043E\u043B\u044C\u043A\u043E \u043B\u0435\u0442 \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0441\u044F
      \u0441 \u0434\u0443\u0445\u043E\u043C, \u0430 \u043F\u043E\u043C\u043E\u0433
      \u0432 \u0438\u0442\u043E\u0433\u0435 \u043D\u043E\u0432\u044B\u0439 \u0434\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496263
    m_Localized: "\u0417\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A: \u0422\u0435\u043F\u0435\u0440\u044C
      \u0443 \u043C\u0435\u043D\u044F \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043C\u0430\u0448\u0438\u043D\u0430 \u043F\u043E\u0447\u0442\u0438 \u0441\u043E\u0431\u0440\u0430\u043D\u0430,
      \u043D\u043E \u0438 \u0436\u0438\u0437\u043D\u044C \u0431\u0443\u0434\u0442\u043E
      \u0441 \u043C\u0435\u0441\u0442\u0430 \u0441\u0434\u0432\u0438\u043D\u0443\u043B\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496264
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0420\u0430\u0434 \u0437\u0430
      \u0442\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496265
    m_Localized: "\u0417\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A: \u0418
      \u044F \u0437\u0430 \u0441\u0435\u0431\u044F \u0440\u0430\u0434! \u041B\u0430\u0434\u043D\u043E,
      \u043D\u0435 \u0431\u0443\u0434\u0443 \u0442\u0435\u0431\u044F \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C.
      \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0438 \u0443 \u0442\u0435\u0431\u044F
      \u0441 \u041A\u043E\u0442\u0438\u043A\u043E\u043C \u0432\u0441\u0435 \u0441\u043B\u043E\u0436\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496266
    m_Localized: "\u0417\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A: \u0421\u043F\u0430\u0441\u0438\u0431\u043E
      \u0442\u0435\u0431\u0435. \u0411\u0435\u0437 \u0442\u0435\u0431\u044F \u044F
      \u0431\u044B \u0442\u0430\u043A \u0438 \u043D\u0435 \u0440\u0435\u0448\u0438\u043B\u0441\u044F
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441 \u0411\u0443\u043B\u043E\u0447\u043D\u0438\u0446\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496267
    m_Localized: "\u041A\u043E\u0442\u0438\u043A: \u041C\u044F\u0443!?"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496268
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041A\u0442\u043E \u0442\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496269
    m_Localized: "\u041A\u043E\u0442\u0438\u043A: \u042F... \u042F \u043D\u0435 \u0437\u043D\u0430\u044E..."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496270
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0422\u0438\u0448\u0435, \u0442\u0438\u0448\u0435.
      \u041B\u0443\u0447\u0448\u0435 \u0441\u043A\u0430\u0436\u0438, \u0433\u0434\u0435
      \u0442\u0432\u043E\u0439 \u0434\u043E\u043C, \u0438 \u044F \u0442\u0435\u0431\u044F
      \u0442\u0443\u0434\u0430 \u043E\u0442\u0432\u0435\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496271
    m_Localized: "\u041A\u043E\u0442\u0438\u043A: \u042F \u043D\u0435 \u0437\u043D\u0430\u044E,
      \u0433\u0434\u0435 \u043C\u043E\u0439 \u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496272
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041A\u0430\u043A \u0434\u0430\u0432\u043D\u043E
      \u0442\u044B \u0442\u0443\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496273
    m_Localized: "\u041A\u043E\u0442\u0438\u043A: \u0422\u0443\u0442 \u0445\u043E\u043B\u043E\u0434\u043D\u043E
      \u0438 \u0433\u043E\u043B\u043E\u0434\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496274
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041B\u0430\u0434\u043D\u043E,
      \u0441\u0430\u0434\u0438\u0441\u044C \u0432 \u043C\u0430\u0448\u0438\u043D\u0443,
      \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0435\u043C, \u0447\u0442\u043E
      \u0441 \u0442\u043E\u0431\u043E\u0439 \u0434\u0435\u043B\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496275
    m_Localized: "\u041A\u043E\u0442\u0438\u043A: \u041C\u043D\u0435 \u0445\u043E\u043B\u043E\u0434\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496276
    m_Localized: "\u0424\u0435\u0440\u043C\u0435\u0440\u0435\u043D\u043E\u043A: \u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
      \u0434\u044F\u0434\u0435\u043D\u044C\u043A\u0430\u2026 \u0410 \u0412\u044B
      \u043A\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496277
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u042F \u0434\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A.
      \u041C\u0435\u043D\u044F \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0438
      \u043F\u0440\u0438\u0432\u0435\u0437\u0442\u0438 \u0434\u0432\u0430 \u043F\u0430\u043A\u0435\u0442\u0430
      \u043C\u043E\u043B\u043E\u043A\u0430 \u0438\u0437 \u0444\u0435\u0440\u043C\u044B
      \u0434\u043B\u044F \u0431\u0443\u043B\u043E\u0447\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222086496278
    m_Localized: "\u0424\u0435\u0440\u043C\u0435\u0440\u0435\u043D\u043E\u043A: \u0428\u043B\u0435\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884864
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884865
    m_Localized: "\u0424\u0435\u0440\u043C\u0435\u0440\u0435\u043D\u043E\u043A: \u041F\u0440\u0438\u0432
      \u0447\u0434 \u043A\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884866
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041A\u0440\u0438\u043D\u0436\u0430\u043D\u0443\u043B
      \u043D\u0435 \u043F\u043E \u0434\u0435\u0442\u0441\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884867
    m_Localized: "\u0424\u0435\u0440\u043C\u0435\u0440\u0435\u043D\u043E\u043A: \u0428\u043B\u0435\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884868
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884869
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
      \u0412\u044B \u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440?"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884870
    m_Localized: "\u0423\u0447\u0438\u0442\u0435\u043B\u044C: \u0414\u0430, \u0430
      \u0412\u044B, \u043B\u044E\u0431\u0435\u0437\u043D\u0435\u0439\u0448\u0438\u0439,
      \u0443 \u043D\u0430\u0441 \u043D\u043E\u0432\u044B\u0439 \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C?
      \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E \u0437\u0430 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435!!"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884871
    m_Localized: "\u0423\u0447\u0438\u0442\u0435\u043B\u044C: \u0415\u0441\u043B\u0438
      \u0447\u0435\u043C-\u0442\u043E \u043C\u043E\u0433\u0443 \u0431\u044B\u0442\u044C
      \u0412\u0430\u043C \u043F\u043E\u043B\u0435\u0437\u0435\u043D, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441\u043A\u0430\u0436\u0438\u0442\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884872
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u042F \u043D\u0430\u0448\u0435\u043B
      \u041A\u043E\u0442\u0435\u043D\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0442, \u0433\u0434\u0435 \u0435\u0433\u043E
      \u0434\u043E\u043C. \u041C\u043E\u0436\u0435\u0442, \u0437\u043D\u0430\u0435\u0442\u0435,
      \u043A\u0443\u0434\u0430 \u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E
      \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0438\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884873
    m_Localized: "\u0423\u0447\u0438\u0442\u0435\u043B\u044C: \u0423 \u043D\u0430\u0441
      \u0435\u0441\u0442\u044C \u0438\u043D\u0442\u0435\u0440\u043D\u0430\u0442 \u0434\u043B\u044F
      \u0434\u0435\u0442\u0435\u0439. \u0422\u043E\u043B\u044C\u043A\u043E, \u0443\u0432\u044B,
      \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u0443 \u043D\u0430\u0441
      \u043F\u043B\u0430\u0442\u043D\u043E\u0435: \u0448\u043A\u043E\u043B\u0435
      \u043D\u0443\u0436\u043D\u043E \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0442\u044C
      \u0435\u0434\u0443, \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u0438, \u0440\u0430\u0431\u043E\u0442\u0443
      \u0443\u0447\u0438\u0442\u0435\u043B\u0435\u0439\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884874
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0418 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0441\u0442\u043E\u0438\u0442 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884875
    m_Localized: "\u0423\u0447\u0438\u0442\u0435\u043B\u044C: 5000"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884876
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0422\u0430\u043A \u043C\u043D\u043E\u0433\u043E!?
      \u0413\u0434\u0435 \u043C\u043D\u0435 \u0432\u0437\u044F\u0442\u044C \u0442\u0430\u043A\u0438\u0435
      \u0434\u0435\u043D\u044C\u0433\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884877
    m_Localized: "\u0423\u0447\u0438\u0442\u0435\u043B\u044C: \u041D\u0430 \u041E\u0441\u0442\u0440\u043E\u0432\u0435
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0430\u0439\u0434\u0443\u0442\u0441\u044F
      \u0442\u0435, \u043A\u043E\u043C\u0443 \u043D\u0443\u0436\u043D\u043E \u0447\u0442\u043E
      \u0442\u043E \u043F\u0440\u0438\u0432\u0435\u0437\u0442\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884878
    m_Localized: "\u0423\u0447\u0438\u0442\u0435\u043B\u044C: \u041A \u0441\u043B\u043E\u0432\u0443,
      \u043C\u043E\u0436\u0435\u0442 \u0412\u044B \u043E\u0442\u0432\u0435\u0437\u0435\u0442\u0435
      \u044D\u0442\u0438 \u0441\u0442\u0430\u0440\u044B\u0435 \u043A\u043D\u0438\u0433\u0438?
      \u041E\u043D\u0438 \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442 \u043B\u0435\u0436\u0430\u0442
      \u0431\u0435\u0437 \u043F\u043E\u043B\u044C\u0437\u044B \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884879
    m_Localized: "\u0423\u0447\u0438\u0442\u0435\u043B\u044C: \u041D\u0435 \u043C\u043E\u0433\u043B\u0438
      \u0431\u044B \u0412\u044B \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0438\u0445 \u0411\u0430\u0431\u0443\u0448\u043A\u0435 \u0421\u043E\u0432\u0435?
      \u0423\u0436 \u043E\u0447\u0435\u043D\u044C \u043E\u043D\u0430 \u043B\u044E\u0431\u0438\u0442
      \u0434\u0435\u0442\u0435\u043A\u0442\u0438\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884880
    m_Localized: "\u0423\u0447\u0438\u0442\u0435\u043B\u044C: \u0415\u0437\u0436\u0430\u0439,
      \u044F \u0436\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884881
    m_Localized: "\u0423\u0447\u0438\u0442\u0435\u043B\u044C: \u042D\u0442\u043E
      \u043C\u043E\u0439 2 \u043A\u0432\u0435\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884882
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884883
    m_Localized: "\u0423\u0447\u0438\u0442\u0435\u043B\u044C: \u042D\u0442\u043E
      \u043F\u043E\u0441\u043B\u0435 \u043C\u043E\u0435\u0433\u043E 2 \u043A\u0432\u0435\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884884
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884885
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u0412\u043E\u0442
      \u0434\u0430\u0436\u0435 \u043A\u0430\u043A..."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884886
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0412\u0430\u0448 \u0441\u044B\u043D
      \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0435\u0442 \u0443\u0447\u0438\u0442\u044C\u0441\u044F
      \u043D\u0435 \u043E\u0434\u0438\u043D. \u041E\u043D \u0441\u0430\u043C \u0445\u043E\u0442\u0435\u043B
      \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0412\u0430\u0441 \u0432\u0437\u044F\u0442\u044C
      \u041A\u043E\u0442\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884887
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u0421\u0430\u043C
      \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884888
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0414\u0430. \u0414\u043B\u044F
      \u043D\u0435\u0433\u043E \u044D\u0442\u043E \u0432\u0430\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884889
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u0417\u043D\u0430\u0435\u0442\u0435...
      \u044F \u0438 \u043F\u0440\u0430\u0432\u0434\u0430, \u043F\u043E\u0436\u0430\u043B\u0443\u0439,
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0447\u0430\u0441\u0442\u043E \u0434\u0443\u043C\u0430\u044E
      \u043E \u0441\u0447\u0435\u0442\u0430\u0445, \u0434\u0440\u043E\u0432\u0430\u0445,
      \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u0430\u0445 \u0438 \u0437\u0430\u0431\u044B\u0432\u0430\u044E,
      \u0440\u0430\u0434\u0438 \u043A\u043E\u0433\u043E \u0432\u0441\u0435 \u044D\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884890
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u0415\u0441\u043B\u0438
      \u043C\u043E\u0439 \u0441\u044B\u043D \u0445\u043E\u0447\u0435\u0442, \u0447\u0442\u043E\u0431\u044B
      \u041A\u043E\u0442\u0438\u043A \u0443\u0447\u0438\u043B\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u043D\u0438\u043C, \u0437\u043D\u0430\u0447\u0438\u0442, \u0442\u0430\u043A
      \u0442\u043E\u043C\u0443 \u0438 \u0431\u044B\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884891
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041F\u0440\u0430\u0432\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884892
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u0414\u0430.
      \u042F \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E \u041A\u043E\u0442\u0438\u043A\u0430
      \u0432 \u0448\u043A\u043E\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884893
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0421\u043F\u0430\u0441\u0438\u0431\u043E
      \u0412\u0430\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884894
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u041D\u0435
      \u0441\u0442\u043E\u0438\u0442. \u0418\u043D\u043E\u0433\u0434\u0430 \u0448\u043A\u043E\u043B\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0443\u0436\u043D\u044B \u043D\u0435 \u0434\u0435\u043D\u044C\u0433\u0438,
      \u0430 \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u043E\u0442, \u043E \u043A\u043E\u043C
      \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884895
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E.
      \u041F\u043E\u0445\u043E\u0436\u0435, \u0434\u043B\u044F \u0432\u0430\u0448\u0435\u0433\u043E
      \u041A\u043E\u0442\u0438\u043A\u0430 \u044D\u0442\u043E \u0438 \u0435\u0441\u0442\u044C
      \u043D\u043E\u0432\u044B\u0439 \u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884896
    m_Localized: "\u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440: \u041A\u043E\u0442\u0438\u043A
      \u043C\u043E\u0436\u0435\u0442 \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F.
      \u0414\u043B\u044F \u043D\u0435\u0433\u043E \u0432 \u0448\u043A\u043E\u043B\u0435
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0430\u0439\u0434\u0435\u0442\u0441\u044F
      \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884897
    m_Localized: "\u0418\u0433\u0440\u043E\u043A:  \u0412\u043E\u0442 \u0412\u044B
      \u0433\u0434\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884898
    m_Localized: "\u0421\u043E\u0432\u0430: \u0412 \u0437\u0434\u043E\u0440\u043E\u0432\u043E\u043C
      \u0442\u0435\u043B\u0435 \u2013 \u0437\u0434\u043E\u0440\u043E\u0432\u044B\u0439
      \u0434\u0443\u0445! \u0412 \u043C\u043E\u0438\u0445 \u0433\u043E\u0434\u0430\u0445
      \u044D\u0442\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E. \u0410 \u0412\u044B, \u043C\u043E\u043B\u043E\u0434\u043E\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u0442\u043E\u0442 \u0441\u0430\u043C\u044B\u0439
      \u043D\u043E\u0432\u044B\u0439 \u0434\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A?
      \u041D\u0430\u0441\u043B\u044B\u0448\u0430\u043D\u0430. \u041E\u0447\u0435\u043D\u044C
      \u043F\u0440\u0438\u044F\u0442\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884899
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0418 \u043C\u043D\u0435. \u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440
      \u043F\u0440\u043E\u0441\u0438\u043B \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C
      \u043F\u043E\u0441\u044B\u043B\u043A\u0443. \u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435,
      \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884900
    m_Localized: "\u0421\u043E\u0432\u0430: \u0412\u043E\u0442 \u0441\u043F\u0430\u0441\u0438\u0431\u043E!
      \u041A\u0430\u043A \u0442\u0430\u043C \u0432\u043D\u0443\u0447\u0435\u043A
      \u043C\u043E\u0439? \u0420\u0430\u0431\u043E\u0442\u0430\u0435\u0442? \u0422\u0435\u043F\u043B\u043E
      \u043E\u0434\u0435\u0432\u0430\u0435\u0442\u0441\u044F? (\u0441\u043C\u0435\u0435\u0442\u0441\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884901
    m_Localized: "\u0421\u043E\u0432\u0430: \u0410 \u043F\u0440\u0430\u0432\u043D\u0443\u043A\u0438
      \u043A\u043E\u0433\u0434\u0430? \u042D\u0445, \u0432\u043E\u0442 \u043E\u0441\u0442\u0430\u0432\u0438\u0442
      \u0436\u0435 \u0431\u0430\u0431\u0443\u0448\u043A\u0443 \u0431\u0435\u0437
      \u043F\u0440\u0430\u0432\u043D\u0443\u043A\u043E\u0432! \u0421\u043B\u0443\u0447\u0430\u0435\u043C,
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0442\u0435, \u043E\u043D \u0442\u0430\u043C
      \u0441\u0435\u0431\u0435 \u043D\u0435\u0432\u0435\u0441\u0442\u043A\u0443 \u0435\u0449\u0435
      \u043D\u0435 \u043D\u0430\u0448\u0435\u043B? \u041C\u043E\u0436\u0435\u0442,
      \u0435\u043C\u0443 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043A\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884902
    m_Localized: "\u0418\u0433\u0440\u043E\u043A:"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884903
    m_Localized: "\u0421\u043E\u0432\u0430: \u0415\u0437\u0436\u0430\u0439, \u0435\u0437\u0436\u0430\u0439
      \u0432\u043D\u0443\u0447\u0435\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884904
    m_Localized: "\u0411\u0430\u0431\u0443\u0448\u043A\u0430: \u041A\u0430\u043A
      \u043F\u0430\u0445\u043D\u0443\u0442 \u044D\u0442\u0438 \u0431\u0443\u043B\u043A\u0438!
      \u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0412\u0430\u043C, \u0447\u0442\u043E
      \u0442\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u0440\u0438\u0435\u0445\u0430\u043B\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884905
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0412\u0441\u0435\u0433\u0434\u0430
      \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884906
    m_Localized: "\u0421\u043E\u0432\u0430: \u0428\u043B\u0435\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884907
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884908
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u0423 \u043C\u0435\u043D\u044F
      \u0437\u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F \u0431\u0435\u043D\u0437\u0438\u043D,
      \u043D\u0430\u0434\u043E \u0431\u044B \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0441 \u0437\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A\u043E\u043C..."
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884909
    m_Localized: "\u0411\u0443\u043B\u043E\u0447\u043D\u0438\u0446\u0430: \u041F\u0440\u0438\u0432
      \u0447\u0434 \u043A\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884910
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041A\u0440\u0438\u043D\u0436\u0430\u043D\u0443\u043B
      \u043D\u0435 \u043F\u043E \u0434\u0435\u0442\u0441\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884911
    m_Localized: "\u0411\u0443\u043B\u043E\u0447\u043D\u0438\u0446\u0430: \u0428\u043B\u0435\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884912
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 22126222094884913
    m_Localized: "\u0411\u0443\u043B\u043E\u0447\u043D\u0438\u0446\u0430: \u042D\u0442\u043E
      \u043C\u043E\u0439 2 \u0434\u0438\u0430\u043B\u043E\u0433"
    m_Metadata:
