  m_TableData:
  - m_Id: 12822695597678592
    m_Localized: "\u042D\u0442\u043E \u043F\u0440\u0438\u043C\u0435\u0440. \u041F\u0440\u0438\u0432\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 12832438861012998
    m_Localized: 'Capsley: Maybe you should be called Grumpy {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 12832438861012997
    m_Localized: 'Capsley: No need to be so rude...'
    m_Metadata:
      m_Items: []
  - m_Id: 12832438861012996
    m_Localized: 'Capsley: Nice to meet you {0}!'
    m_Metadata:
      m_Items: []
  - m_Id: 12832438861012995
    m_Localized: Pyramid. Why - who wants to know?
    m_Metadata:
      m_Items: []
  - m_Id: 12832438861012994
    m_Localized: The name's Triquandle.
    m_Metadata:
      m_Items: []
  - m_Id: 12832438861012993
    m_Localized: I'm Capsule, but my friends call me "Tic Tac". No idea why...
    m_Metadata:
      m_Items: []
  - m_Id: 12832438861012992
    m_Localized: 'Capsley: Who are you then?'
    m_Metadata:
      m_Items: []
  - m_Id: 12832438827458560
    m_Localized: 'Capsley: Hello, I am Mr Capsley.'
    m_Metadata:
      m_Items: []
  - m_Id: 15954733523640320
    m_Localized: This is an example of a Yarn Spinner script. Write your dialogue
      here!
    m_Metadata:
      m_Items: []
  - m_Id: 18513719343030282
    m_Localized: "\u0422\u0435\u0434: \u043E\u043A\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 18513719343030281
    m_Localized: "\u0422\u0435\u0434: \u0431\u043E\u0436\u0443\u0440\u0432\u0432\u0432\u0432\u0432\u0432\u0432\u0432\u0432\u0432\u0432\u0432\u0432\u0432\u0432\u0432\u0432\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 18513719343030280
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u043C\u043C\u043C\u043C\u043C\u043C\u043C\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 18513719343030279
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041A\u0430\u043A\u0430\u044F
      \u0432\u043A\u0443\u0441\u043D\u0430\u044F \u0448\u0430\u0432\u0443\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 16414394739695616
    m_Localized: "\u0422\u0435\u0434: \u041F\u0440\u0438\u0432\u0435\u0442. \u042F
      \u0422\u0435\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 16414394739695617
    m_Localized: "\u0422\u0435\u0434: \u041A\u0430\u043A \u0442\u0432\u043E\u0438
      \u0434\u0435\u043B\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 16414394739695618
    m_Localized: "\u0418\u0433\u0440\u043E\u043A: \u041D\u0430\u0439\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 16414394739695619
    m_Localized: "\u0422\u0435\u0434: \u0425\u043E\u0447\u0435\u0448\u044C \u0448\u0430\u0443\u0440\u043C\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 16414890133135360
    m_Localized: "\u0414\u0430\u0432\u0430\u0439 (\u0423 \u0442\u0435\u0431\u044F
