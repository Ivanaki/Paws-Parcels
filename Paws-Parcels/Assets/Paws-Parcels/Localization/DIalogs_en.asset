    m_Localized: "Player: Ok"
    m_Metadata:
      m_Items: []
  - m_Id: 22120427215118365
    m_Localized: "Player:  Вот Вы где!"
    m_Metadata:
      m_Items: []
  - m_Id: 22120427215118366
    m_Localized: "Owl: A sound mind in a sound body! At my age, that becomes obvious. And you, young man, must be that new delivery driver I've heard so much about. Very pleased!"
