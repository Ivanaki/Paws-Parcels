  - m_Id: 22120369061093376
    m_Localized: "Gas Station Attendant: If you happen to pass by, ask how the Baker is doing for me. Is everything all right with her?"
    m_Metadata:
      m_Items: []
  - m_Id: 22120369061093377
    m_Localized: "Gas Station Attendant: bonjourrrrrrrrrrrrr"
    m_Metadata:
      m_Items: []
  - m_Id: 22120369061093378
    m_Localized: "Gas Station Attendant: okaaaaaa..."
    m_Metadata:
      m_Items: []
  - m_Id: 22120369065287680
    m_Localized: "Cat: I... I don't know..."
    m_Metadata:
      m_Items: []
  - m_Id: 22120369065287681
    m_Localized: "Cat: I'm cold!"
