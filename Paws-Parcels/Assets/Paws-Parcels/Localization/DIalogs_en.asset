  - m_Id: 22120598380470279
    m_Localized: "Player: That was seriously cringe."
    m_Metadata:
      m_Items: []
  - m_Id: 22120598380470280
    m_Localized: "Player: Ok"
    m_Metadata:
      m_Items: []
  - m_Id: 22120598380470281
    m_Localized: "Teacher: Could you deliver them to Grandma Owl? She absolutely loves detective stories."
    m_Metadata:
      m_Items: []
  - m_Id: 22120598380470282
    m_Localized: "Player: Ok"
    m_Metadata:
      m_Items: []
  - m_Id: 22120598380470283
    m_Localized: "Player: Ok"
    m_Metadata:
      m_Items: []
  - m_Id: 22120598380470284
    m_Localized: "Player: Ok"
    m_Metadata:
      m_Items: []
  - m_Id: 22120598380470285
    m_Localized: "Player: Likewise. The Principal asked me to deliver a package. Here you go."
    m_Metadata:
      m_Items: []
  - m_Id: 22120598380470286
    m_Localized: "Player: Ok"
    m_Metadata:
      m_Items: []
