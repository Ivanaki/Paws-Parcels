    m_Metadata:
      m_Items: []
  - m_Id: 27577219126648832
    m_Localized: "\u041E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0435
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 27577355412168704
    m_Localized: "\u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u043D\u044B\u0439
      \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 27577814461964288
    m_Localized: "\u041A\u043E\u0440\u043E\u0431\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 27577906199781376
    m_Localized: "\u041E\u0442\u043D\u0435\u0441\u0438 \u043A\u043E\u0440\u043E\u0431\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 27578015268462592
    m_Localized: "\u041E\u0442\u043D\u0435\u0441\u044C\u0442\u0438 \u043A\u043E\u0440\u043E\u0431\u043A\u0438
      \u043A \u043C\u0435\u0441\u0442\u0443 \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 27717338789830656
    m_Localized: "\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 27717627030790144
    m_Localized: "\u041C\u043E\u043D\u043E\u043B\u043E\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 27717987690602496
    m_Localized: "\u0413\u043B\u0430\u0432\u043D\u044B\u0439 \u0433\u0435\u0440\u043E\u0439
      \u043E \u0441\u0432\u043E\u0435\u043C \u043F\u0440\u043E\u0448\u043B\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 27718567909646336
    m_Localized: "\u041A\u0430\u0442-\u0441\u0446\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 27718738638790656
    m_Localized: "\u041D\u0430\u0447\u0430\u043B\u043E \u043D\u0430\u0448\u0435\u0439
      \u0438\u0441\u0442\u043E\u0440\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 27724618209943552
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u0417\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 27724677420933120
    m_Localized: "\u041D\u0430\u0434\u043E \u0443\u0437\u043D\u0430\u0442\u044C \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443
      \u0438 \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u0440\u043E
      \u0431\u0435\u043D\u0437\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 27742786651414528
    m_Localized: "\u041F\u043E\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043A\u043E\u0440\u043E\u0431\u043A\u0438 "
    m_Metadata:
      m_Items: []
  - m_Id: 27742852720091136
    m_Localized: "\u041D\u0430\u0434\u043E \u0432\u0437\u044F\u0442\u044C \u043A\u043E\u0440\u043E\u0431\u043A\u0438
      \u0438 \u0437\u0430\u043A\u0438\u043D\u0443\u0442\u044C \u0438\u0445 \u043D\u0430
      \u043A\u0440\u044B\u0448\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 27699987153969152
    m_Localized: "\u0447\u0442\u043E-\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 27968963672457216
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
      \u043A\u043E\u0440\u043E\u0431\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 27969032329019392
    m_Localized: "\u0415\u0449\u0435 \u043E\u0434\u043D\u0430 \u043A\u043E\u0440\u043E\u0431\u043A\u0430,
      \u043D\u043E \u043E\u043D\u0430 \u043A\u0430\u043A\u0430\u044F-\u0442\u043E
      \u0441\u0442\u0440\u0430\u043D\u043D\u0430\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 30471764227121152
    m_Localized: "\u041A\u0442\u043E \u044D\u0442\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 30471836599836672
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u041A\u043E\u0442\u0438\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 30471894925828096
    m_Localized: "\u041E\u0442\u043D\u0435\u0441\u0442\u0438 \u041A\u043E\u0442\u0438\u043A\u0430
      \u0432 \u041C\u0430\u0448\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 30472013670768640
    m_Localized: "\u041D\u0430\u0434\u043E \u0437\u0430\u0431\u0440\u0430\u0442\u044C
      \u041A\u043E\u0442\u0438\u043A\u0430 \u0438 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C
      \u043D\u0430 \u0434\u0438\u0432\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 30472096415997952
    m_Localized: "\u0421\u0435\u0441\u0442\u044C \u0437\u0430 \u0440\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30472146307244032
    m_Localized: "\u041F\u043E\u0440\u0430 \u0432 \u0434\u043E\u0440\u043E\u0433\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 30472188065734656
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043A\u043E\u0440\u043E\u0431\u043A\u0438
      \u0432 \u0448\u043A\u043E\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 30472254969077760
    m_Localized: "\u041C\u043E\u044F \u043F\u0435\u0440\u0432\u0430\u044F \u0437\u0430\u0434\u0430\u0447\u0430!
      \u0420\u0430\u0434 \u0431\u044B\u0442\u044C \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u043C
      \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 30472411596972032
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043A\u043D\u0438\u0433\u0438
      \u0411\u0430\u0431\u0443\u0448\u043A\u0435 \u0421\u043E\u0432\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30472551900635136
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u0414\u0438\u0440\u0435\u043A\u0442\u043E\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 30472629151326208
    m_Localized: "\u041D\u0430\u0434\u043E \u0431\u044B \u0443\u0437\u043D\u0430\u0442\u044C
      \u0447\u0442\u043E \u043C\u043D\u0435 \u0434\u0435\u043B\u0430\u0442\u044C
      \u0441 \u041A\u043E\u0442\u0438\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 30472678455369728
    m_Localized: "\u041F\u043E\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043A\u043D\u0438\u0433\u0438
      \u0432\u043D\u0443\u0442\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30472738429722624
    m_Localized: "\u041D\u0430\u0434\u043E \u043E\u0442\u043D\u0435\u0441\u0442\u0438
      \u043A\u043D\u0438\u0433\u0438 \u0432\u043D\u0443\u0442\u0440\u044C \u0438
      \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u0432 \u0448\u043A\u0430\u0444!"
    m_Metadata:
      m_Items: []
  - m_Id: 30472804133494784
    m_Localized: "\u041E\u0442\u0432\u0435\u0437\u0442\u0438 \u043A\u043D\u0438\u0433\u0438
      \u0411\u0430\u0431\u0443\u0448\u043A\u0435 \u0432 \u0433\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 30473110200246272
    m_Localized: "\u0412\u043E\u0442 \u044D\u0442\u043E \u0434\u0430, \u0432\u043F\u0435\u0440\u0432\u044B\u0435
      \u0432 \u0436\u0438\u0437\u043D\u0438 \u043F\u043E\u0431\u044B\u0432\u0430\u044E
      \u0432 \u0433\u043E\u0440\u0430\u0445! \u0413\u043B\u0430\u0432\u043D\u043E\u0435
      \u043D\u0435 \u0443\u043F\u0430\u0441\u0442\u044C \u0432 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30473294091116544
    m_Localized: "\u0411\u0443\u043B\u043E\u0447\u043A\u0438 \u0434\u043B\u044F \u0411\u0430\u0431\u0443\u0448\u043A\u0438
      \u0421\u043E\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 30473384063131648
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u0411\u0430\u0431\u0443\u0448\u043A\u043E\u0439 \u0421\u043E\u0432\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 30473456456818688
    m_Localized: "\u041D\u0430\u0434\u043E \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C, \u043A\u0430\u043A \u0443
      \u043D\u0435\u0435 \u0434\u0435\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30544243364716544
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u043F\u0443\u043C\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 30544349996507136
    m_Localized: "\u041D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043F\u043E\u0433\u043E\u0432\u0440\u0438\u0442\u044C,
      \u0447\u0442\u043E\u044B\u0431\u044B \u0443\u0437\u043D\u0430\u0442\u044C \u043F\u0440\u043E
      \u0431\u0443\u043B\u043E\u0447\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 30544881892974592
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u0441 \u0444\u0435\u0440\u043C\u044B
      \u043C\u043E\u043B\u043E\u043A\u043E \u0434\u043B\u044F \u0432\u044B\u043F\u0435\u0447\u043A\u0438 "
    m_Metadata:
      m_Items: []
  - m_Id: 30545565950402560
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0441 \u0444\u0435\u0440\u043C\u0435\u0440\u0435\u043D\u043A\u043E\u043C "
    m_Metadata:
      m_Items: []
  - m_Id: 30545703951392768
    m_Localized: "\u041E\u0442\u0432\u0435\u0441\u0442\u0438 \u043C\u043E\u043B\u043E\u043A\u043E
      \u0432 \u043F\u0435\u043A\u0430\u0440\u043D\u044E "
    m_Metadata:
      m_Items: []
  - m_Id: 30545910277595136
    m_Localized: "\u0421\u0420\u041E\u0427\u041D\u041E \u0438\u043D\u0430\u0447\u0435
      \u043C\u043E\u043B\u043E\u043A\u043E \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u0442\u0441\u044F "
    m_Metadata:
      m_Items: []
  - m_Id: 30546130201731072
    m_Localized: "\u041E\u0442\u0432\u0435\u0437\u0442\u0438 \u043F\u0438\u0440\u043E\u0433
      \u0432 \u0448\u043A\u043E\u043B\u0443 "
    m_Metadata:
      m_Items: []
  - m_Id: 30546245347958784
    m_Localized: "\u0411\u042B\u0421\u0422\u0420\u0415\u0415, \u0438\u043D\u0430\u0447\u0435
      \u043F\u0438\u0440\u043E\u0433 \u043E\u0441\u0442\u044B\u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  references:
