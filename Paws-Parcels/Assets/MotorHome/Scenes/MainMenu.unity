  m_text: "\u0410 \u043F\u0440\u0430\u0432\u043D\u0443\u043A\u0438 \u043A\u043E\u0433\u0434\u0430?
    \u042D\u0445, \u0432\u043E\u0442 \u043E\u0441\u0442\u0430\u0432\u0438\u0442 \u0436\u0435
    \u0431\u0430\u0431\u0443\u0448\u043A\u0443 \u0431\u0435\u0437 \u043F\u0440\u0430\u0432\u043D\u0443\u043A\u043E\u0432!
    \u0421\u043B\u0443\u0447\u0430\u0435\u043C, \u043D\u0435 \u0437\u043D\u0430\u0435\u0442\u0435,
    \u043E\u043D \u0442\u0430\u043C \u0441\u0435\u0431\u0435 \u043D\u0435\u0432\u0435\u0441\u0442\u043A\u0443
    \u0435\u0449\u0435 \u043D\u0435 \u043D\u0430\u0448\u0435\u043B? \u041C\u043E\u0436\u0435\u0442,
    \u0435\u043C\u0443 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043A\u0442\u043E?\u044B
    \u0430\u0440\u0443\u0448\u0433\u0439\u0443\u0420\u0413 \u0423\u041F\u041A\u0413
    \u0423\u0420\u041F\u041A\u0413\u0423\u041A \u0420\u041F\u0413\u0423\u041F\u041A
    \u0420\u0413\u0423\u041A \u041F\u0420\u0413\u0423\u041A\u0420 \u041F\u041F\u0413\u0423\u041A
    \u0420\u0413 \u0423\u041A\u041F\u0420\u041A\u041F\u0413 \u0423\u0413\u0420\u0413
    \u0423\u041A\u0413\u041F\u0420"
