  <Dialogs>k__BackingField:
  - <Dialog>k__BackingField: 10
    <Phrases>k__BackingField:
    - <WhoTalking>k__BackingField: 0
      <Phrases>k__BackingField:
      - "\u042F \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u0430\u043B\u0435\u043A\u043E
        \u043E\u0442 \u043A\u043E\u0442\u0435\u043D\u043A\u0430"
      - "\u042F \u0437\u0430 \u043D\u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u044E"
  - <Dialog>k__BackingField: 0
    <Phrases>k__BackingField:
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u041C\u044F\u0443!?"
    - <WhoTalking>k__BackingField: 0
      <Phrases>k__BackingField:
      - "\u041A\u0442\u043E \u0442\u044B?"
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u042F... \u042F \u043D\u0435 \u0437\u043D\u0430\u044E (\u041F\u043B\u0430\u0447\u0435\u0442.)"
    - <WhoTalking>k__BackingField: 0
      <Phrases>k__BackingField:
      - "\u0422\u0438\u0448\u0435, \u0442\u0438\u0448\u0435. \u041B\u0443\u0447\u0448\u0435
        \u0441\u043A\u0430\u0436\u0438, \u0433\u0434\u0435 \u0442\u0432\u043E\u0439
        \u0434\u043E\u043C, \u0438 \u044F \u0442\u0435\u0431\u044F \u0442\u0443\u0434\u0430
        \u043E\u0442\u0432\u0435\u0437\u0443."
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u042F \u043D\u0435 \u0437\u043D\u0430\u044E, \u0433\u0434\u0435 \u043C\u043E\u0439
        \u0434\u043E\u043C"
    - <WhoTalking>k__BackingField: 0
      <Phrases>k__BackingField:
      - "\u041A\u0430\u043A \u0434\u0430\u0432\u043D\u043E \u0442\u044B \u0442\u0443\u0442?"
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u0422\u0443\u0442 \u0445\u043E\u043B\u043E\u0434\u043D\u043E \u0438 \u0433\u043E\u043B\u043E\u0434\u043D\u043E
        (\u041F\u043B\u0430\u0447\u0435\u0442.)"
    - <WhoTalking>k__BackingField: 0
      <Phrases>k__BackingField:
      - "\u041B\u0430\u0434\u043D\u043E, \u0441\u0430\u0434\u0438\u0441\u044C \u0432
        \u043C\u0430\u0448\u0438\u043D\u0443, \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0435\u043C,
        \u0447\u0442\u043E \u0441 \u0442\u043E\u0431\u043E\u0439 \u0434\u0435\u043B\u0430\u0442\u044C"
  - <Dialog>k__BackingField: 1
    <Phrases>k__BackingField:
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u0423 \u043D\u0430\u0441 \u043D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432\u0435
        \u0440\u0435\u0434\u043A\u043E \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0448\u044C
        \u0433\u043E\u0441\u0442\u0435\u0439. \u041A\u0430\u043A\u0438\u043C\u0438
        \u0441\u0443\u0434\u044C\u0431\u0430\u043C\u0438?"
    - <WhoTalking>k__BackingField: 0
      <Phrases>k__BackingField:
      - "\u042F \u0442\u0443\u0442 \u0436\u0438\u043B \u043C\u043D\u043E\u0433\u043E
        \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434. \u0420\u0435\u0448\u0438\u043B,
        \u0432\u043E\u0442, \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F."
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u041A\u0430\u043A \u0437\u0434\u043E\u0440\u043E\u0432\u043E!"
    - <WhoTalking>k__BackingField: 0
      <Phrases>k__BackingField:
      - "\u0417\u0434\u043E\u0440\u043E\u0432\u043E, \u0447\u0442\u043E \u044F \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F?"
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u0410 \u0435\u0449\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u043E, \u0447\u0442\u043E
        \u0443 \u043D\u0430\u0441 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
        \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u0438\u0441\u0442!"
      - "\u0420\u0430\u043D\u044C\u0448\u0435 \u0437\u0434\u0435\u0441\u044C \u0431\u044B\u043B\u043E
        \u043C\u043D\u043E\u0433\u043E \u043C\u0430\u0448\u0438\u043D, \u0430 \u0442\u0435\u043F\u0435\u0440\u044C
        \u0437\u0430\u043F\u0440\u0430\u0432\u043A\u0430 \u0435\u0441\u0442\u044C,
        \u0430 \u043C\u0430\u0448\u0438\u043D \u043D\u0435\u0442\u2026 \u042D\u0445\u2026"
      - "\u041F\u043E\u0441\u043B\u0443\u0448\u0430\u0439\u2026\u044D\u0442\u043E
        \u0437\u043D\u0430\u0447\u0438\u0442, \u0447\u0442\u043E \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
        \u043D\u0430\u043C \u043E\u0447\u0435\u043D\u044C \u0441\u0438\u043B\u044C\u043D\u043E
        \u043F\u043E\u043C\u043E\u0447\u044C!"
      - "\u041D\u0430\u043C \u043F\u0440\u0438\u0448\u043B\u0438 \u043D\u043E\u0432\u044B\u0435
        \u043F\u0430\u0440\u0442\u044B \u0434\u043B\u044F \u0448\u043A\u043E\u043B\u044B,
        \u043D\u0443\u0436\u043D\u043E \u0438\u0445 \u043E\u0442\u0432\u0435\u0437\u0442\u0438. "
      - "\u041C\u044B \u0432 \u0434\u043E\u043B\u0433\u0443 \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0435\u043C\u0441\u044F,
        \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
        \u0431\u0435\u043D\u0437\u0438\u043D \u0437\u0430 \u043C\u043E\u0439 \u0441\u0447\u0435\u0442!"
    - <WhoTalking>k__BackingField: 0
      <Phrases>k__BackingField:
      - "\u0425\u043E\u0440\u043E\u0448\u043E. \u0410 \u0435\u0449\u0435\u2026"
      - "\u042F \u0442\u0443\u0442 \u043D\u0430\u0448\u0435\u043B \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E
        \u041A\u043E\u0442\u0435\u043D\u043A\u0430. "
      - "\u0413\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u043D\u0435
        \u0437\u043D\u0430\u0435\u0442 \u0447\u0435\u0439 \u043E\u043D \u0438 \u043E\u0442\u043A\u0443\u0434\u0430."
      - "\u041C\u043E\u0436\u0435\u0442, \u0437\u043D\u0430\u0435\u0442\u0435, \u043A\u0443\u0434\u0430
        \u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0438\u0442\u044C? "
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u0425\u043C... \u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435
        \u0441 \u0423\u0447\u0438\u0442\u0435\u043B\u0435\u043C \u0432 \u0448\u043A\u043E\u043B\u0435."
      - "\u041F\u0440\u0438 \u0448\u043A\u043E\u043B\u0435 \u0435\u0441\u0442\u044C
        \u043E\u0431\u0449\u0435\u0436\u0438\u0442\u0438\u0435 \u0434\u043B\u044F
        \u0434\u0435\u0442\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u0436\u0438\u0432\u0443\u0442 \u0434\u0430\u043B\u0435\u043A\u043E"
      - " \u042F \u0434\u0443\u043C\u0430\u044E, \u0435\u0433\u043E \u043C\u043E\u0433\u0443\u0442
        \u043F\u0440\u0438\u043D\u044F\u0442\u044C. "
    - <WhoTalking>k__BackingField: 0
      <Phrases>k__BackingField:
      - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u041A\u0430\u043A \u043C\u043D\u0435
        \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0434\u043E \u0448\u043A\u043E\u043B\u044B?"
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u0412\u043E\u0437\u044C\u043C\u0438 \u044D\u0442\u043E\u0442 \u043A\u043E\u043C\u043F\u0430\u0441.
        \u041E\u043D \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u043A\u0430\u0436\u0435\u0442
        \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043A
        \u0442\u0432\u043E\u0435\u0439 \u0446\u0435\u043B\u0438!"
      - "\u0414\u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0438, \u0434\u0440\u0443\u0433!
        \u0415\u0441\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E \u0431\u0443\u0434\u0435\u0442
        \u043D\u0443\u0436\u043D\u043E, \u043E\u0431\u0440\u0430\u0449\u0430\u0439\u0441\u044F!"
  - <Dialog>k__BackingField: 2
    <Phrases>k__BackingField:
    - <WhoTalking>k__BackingField: 0
      <Phrases>k__BackingField:
      - "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
        \u0412\u044B \u0443\u0447\u0438\u0442\u0435\u043B\u044C?"
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u0414\u0430, \u0430 \u0412\u044B, \u043B\u044E\u0431\u0435\u0437\u043D\u0435\u0439\u0448\u0438\u0439,
        \u0443 \u043D\u0430\u0441 \u043D\u043E\u0432\u044B\u0439 \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C? "
      - "\u0418\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u0440\u0430\u0434 \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0443! "
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u042F \u043F\u0440\u0438\u0432\u0435\u0437 \u0432\u0430\u043C \u043F\u0430\u0440\u0442\u044B."
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E! \u0415\u0441\u043B\u0438
        \u0447\u0435\u043C-\u0442\u043E \u043C\u043E\u0433\u0443 \u0431\u044B\u0442\u044C
        \u0412\u0430\u043C \u043F\u043E\u043B\u0435\u0437\u0435\u043D, \u0442\u043E\u043B\u044C\u043A\u043E
        \u0441\u043A\u0430\u0436\u0438\u0442\u0435!"
    - <WhoTalking>k__BackingField: 0
      <Phrases>k__BackingField:
      - "\u042F \u043D\u0430\u0448\u0435\u043B \u041A\u043E\u0442\u0435\u043D\u043A\u0430,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0435 \u0437\u043D\u0430\u0435\u0442,
        \u0433\u0434\u0435 \u0435\u0433\u043E \u0434\u043E\u043C. "
      - "\u041C\u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0438, \u0447\u0442\u043E
        \u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0438\u0442\u044C
        \u0432 \u043E\u0431\u0449\u0435\u0436\u0438\u0442\u0438\u0435 \u043F\u0440\u0438
        \u0448\u043A\u043E\u043B\u0435."
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u041A\u043E\u043D\u0435\u0447\u043D\u043E, \u043C\u044B \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u043C
        \u0434\u0435\u0442\u0435\u0439 \u0432 \u0438\u043D\u0442\u0435\u0440\u043D\u0430\u0442."
      - "\u0422\u043E\u043B\u044C\u043A\u043E, \u0443\u0432\u044B, \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435
        \u0443 \u043D\u0430\u0441 \u043F\u043B\u0430\u0442\u043D\u043E\u0435: \u0448\u043A\u043E\u043B\u0435
        \u043D\u0443\u0436\u043D\u043E \u043E\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0442\u044C
        \u0435\u0434\u0443, \u0443\u0447\u0435\u0431\u043D\u0438\u043A\u0438, \u0440\u0430\u0431\u043E\u0442\u0443
        \u0443\u0447\u0438\u0442\u0435\u043B\u0435\u0439\u2026 "
    - <WhoTalking>k__BackingField: 0
      <Phrases>k__BackingField:
      - "\u0418 \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u043E\u0438\u0442
        \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435?"
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - 10000
    - <WhoTalking>k__BackingField: 0
      <Phrases>k__BackingField:
      - "\u0422\u0430\u043A \u043C\u043D\u043E\u0433\u043E!?"
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u041F\u0440\u043E\u0441\u0442\u0438\u0442\u0435 \u043C\u0435\u043D\u044F.
        \u041C\u043E\u044F \u0431\u044B \u0432\u043E\u043B\u044F, \u044F \u0431\u044B
        \u043F\u0440\u0438\u043D\u044F\u043B \u0432\u0430\u0448\u0435\u0433\u043E
        \u041A\u043E\u0442\u0435\u043D\u043A\u0430 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E\u2026"
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u0413\u0434\u0435 \u043C\u043D\u0435 \u0432\u0437\u044F\u0442\u044C \u0442\u0430\u043A\u0438\u0435
        \u0434\u0435\u043D\u044C\u0433\u0438?"
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u0415\u0441\u0442\u044C \u0438 \u0445\u043E\u0440\u043E\u0448\u0430\u044F
        \u043D\u043E\u0432\u043E\u0441\u0442\u044C."
      - "\u0418\u0437-\u0437\u0430 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0412\u044B
        \u2013 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439,
        \u0443 \u043A\u043E\u0433\u043E \u0435\u0441\u0442\u044C \u043C\u0430\u0448\u0438\u043D\u0430
        \u043D\u0430 \u041E\u0441\u0442\u0440\u043E\u0432\u0435, \u0432\u0441\u0435\u0433\u0434\u0430
        \u043D\u0430\u0439\u0434\u0443\u0442\u0441\u044F \u0442\u0435, \u043A\u043E\u043C\u0443
        \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u044F\u0442\u0441\u044F \u0412\u0430\u0448\u0438
        \u0443\u0441\u043B\u0443\u0433\u0438."
    - <WhoTalking>k__BackingField: 0
      <Phrases>k__BackingField:
      - "\u041A\u0443\u0434\u0430 \u0434\u0435\u043B\u0438\u0441\u044C \u0434\u0440\u0443\u0433\u0438\u0435
        \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u0438?"
    - <WhoTalking>k__BackingField: 1
      <Phrases>k__BackingField:
      - "\u041A\u0442\u043E-\u0442\u043E \u0443\u0435\u0445\u0430\u043B, \u043A\u0442\u043E-\u0442\u043E
        \u0441\u0442\u0430\u043B \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0442\u0430\u0440,
        - \u0443 \u0432\u0441\u0435\u0445 \u043F\u043E-\u0440\u0430\u0437\u043D\u043E\u043C\u0443."
      - "\u0422\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u0438\u043D \u0417\u0430\u043F\u0440\u0430\u0432\u0449\u0438\u043A
        \u043C\u0435\u0447\u0442\u0430\u0435\u0442 \u0441\u043E\u0431\u0440\u0430\u0442\u044C
        \u0441\u0432\u043E\u044E \u043C\u0430\u0448\u0438\u043D\u0443."
      - "\u041A \u0441\u043B\u043E\u0432\u0443, \u043E\u043D \u043F\u0440\u043E\u0441\u0438\u043B
        \u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043A\u043E\u043B\u0435\u0441\u0430
        \u043E\u0442 \u0448\u043A\u043E\u043B\u044C\u043D\u043E\u0433\u043E \u0430\u0432\u0442\u043E\u0431\u0443\u0441\u0430. "
